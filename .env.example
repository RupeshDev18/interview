# ─────────────────────────────────────────────────────────────
# InterviewPlatform — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://intvwplt:intvwplt_secret@localhost:5432/intvwplt?schema=public

# ── JWT (use strong random secrets in production!) ────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_access_secret_to_64_random_chars_minimum_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_to_64_random_chars_minimum_in_production
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=intvwplt-api
KAFKA_GROUP_ID=intvwplt-consumers

# ── S3 / MinIO (local dev uses MinIO) ─────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=intvwplt-resumes
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── SMTP (local dev uses MailHog) ─────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@intvwplt.com
SMTP_SECURE=false

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Cookies ───────────────────────────────────────────────────
COOKIE_SECRET=change_this_cookie_secret_in_production

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── File Upload ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ── Frontend (Next.js) ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Optional WebRTC TURN server (leave blank to use public STUN only)
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USER=
NEXT_PUBLIC_TURN_CREDENTIAL=
