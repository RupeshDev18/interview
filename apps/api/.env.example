# Backend-specific env — copy to .env
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://intvwplt:intvwplt_secret@postgres:5432/intvwplt?schema=public
JWT_ACCESS_SECRET=change_this_access_secret_to_64_random_chars_minimum_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_to_64_random_chars_minimum_in_production
ACCESS_TOKEN_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=7d
REDIS_URL=redis://redis:6379
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=intvwplt-api
KAFKA_GROUP_ID=intvwplt-consumers
S3_ENDPOINT=http://minio:9000
S3_BUCKET=intvwplt-resumes
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@intvwplt.com
SMTP_SECURE=false
CORS_ORIGINS=http://localhost:3000
COOKIE_SECRET=change_this_cookie_secret_in_production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
MAX_FILE_SIZE_MB=10
